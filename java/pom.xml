<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.opensourceways</groupId>
  <artifactId>obs-sdk-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>obs-sdk-java</name>
  <description>opensourceways 微服务可观测薄封装 SDK (Java) —— 结构化 JSON 日志 + Micrometer/Prometheus 指标，契约见 ../spec</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 1.12.9 受 CVE-2026-40984（micrometer-core HTTP server instrumentation DoS）影响，
         升到 1.15.12 修复。该版本线把 Prometheus registry 的包名从 io.micrometer.prometheus
         改为 io.micrometer.prometheusmetrics，为保持 SDK 对外的 io.micrometer.prometheus
         包名不变（接入方零改动），registry 依赖改用官方过渡产物
         micrometer-registry-prometheus-simpleclient（仍提供旧包名）。 -->
    <micrometer.version>1.15.12</micrometer.version>
    <slf4j.version>2.0.13</slf4j.version>
    <logback.version>1.5.12</logback.version>
    <logstash-encoder.version>7.4</logstash-encoder.version>
    <jackson.version>2.18.8</jackson.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- 指标：micrometer + prometheus registry -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <version>${micrometer.version}</version>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus-simpleclient</artifactId>
      <version>${micrometer.version}</version>
    </dependency>

    <!-- 日志：slf4j API（编译期）；logback + logstash JSON encoder 由接入服务装配 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash-encoder.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- ObsJsonProvider 直接实现 logstash 的 JsonProvider 接口，用其 JsonGenerator 写 JSON
         （转义交给 Jackson，避免手写转义）。版本与 logstash-logback-encoder 7.4 对齐。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>${jackson.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- 可选 Servlet Filter（Java 版请求上下文中间件）；由接入 web 框架的服务引入 -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.0.0</version>
      <scope>provided</scope>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
